# Ambiente e caches
.venv/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Segredos
.env
.env.*
!.env.example

# Cache do Hugging Face (modelos e datasets descarregados)
.cache/
huggingface/

# Pesos e checkpoints: nunca versionar
*.safetensors
*.bin
*.gguf
*.pt
*.pth
# Runs: guardam-se metadados, métricas e previsões (pequenos); pesos e adapters ficam fora.
runs/*
!runs/.gitkeep
!runs/eval-*/
!runs/train-*/
!runs/dry_run-*/
runs/**/adapter*
runs/**/checkpoint-*/
runs/**/trainer/
checkpoints/
outputs/

# Dados de runtime (regerados pelos scripts)
data/runtime/
data/review/*.local.jsonl
*.log

# Exportações locais de adapters (gerado; pesos ignorados pelo git).
exports/
